{
  "theme": "builtin://nord",
  "locale": "en",
  "editor": {
    "use_terminal_bg": true,
    "cursor_style": "steady_block",
    "animations": false,
    "cursor_jump_animation": false,
    "line_numbers": true,
    "relative_line_numbers": true,
    "line_wrap": true,
    "wrap_indent": true,
    "show_menu_bar": true,
    "show_tab_bar": true,
    "show_status_bar": true,
    "show_vertical_scrollbar": true,
    "nerd_font_icons": true,
    "rainbow_brackets": true,
    "use_tabs": false,
    "tab_size": 2,
    "restore_previous_session": true,
    "status_bar": {
      "left": [
        "{remote}",
        "{trust}",
        "{cursor}",
        "{diagnostics}",
        "{cursor_count}",
        "{messages}",
        "{git_statusbar:branch}",
        "{filename}"
      ],
      "right": ["{read_only}", "{line_ending}", "{encoding}", "{language}", "{lsp}", "{warnings}", "{update}", "{palette}"]
    }
  },
  "file_browser": {
    "show_hidden": true
  },
  "keybindings": [
    {
      "keys": [
        {
          "key": "Space"
        },
        {
          "key": "e"
        }
      ],
      "action": "toggle_file_explorer",
      "when": "mode:vi-normal"
    }
  ],
  "plugins": {
    "vi_mode": {
      "enabled": true,
      "settings": {
        "autoStart": true,
        "arrowKeys": true,
        "searchWordUnderCursor": true
      }
    }
  },
  "version": 2,
  "check_for_updates": false,
  "lsp": {
    "python": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    }
  }
}
