# Private secrets — contains live API keys, must never be committed
home-manager/config/zsh/secrets.zsh
# Personal shell history
home-manager/config/zsh/.zsh_history
# Nix build artifact
home-manager/result
# Nix build output symlink (running nix build from repo root)
/result
# Runtime caches generated by apps in their config dirs, e.g. Niri/Noctalia
# wallpaper state and thumbnails under home-manager/config/niri/.cache/
home-manager/config/*/.cache/
# Local backup copies made by editors/tools (kitty.conf.bak,
# config.kdl.backup.2026-05-19_16-20-01); the live files stay tracked
*.bak
*.backup.*
